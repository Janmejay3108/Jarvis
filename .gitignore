# ============================================================================
# JARVIS — repository root == project root
# Secrets and virtualenvs must never enter history, at any depth.
# ============================================================================

# Secrets — never commit
**/.env
**/.env.local
**/*.pem
**/*.key

# Python
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/*.egg-info/
**/*.pyc
**/*.pyo

# Data / artifacts (gitignored per plan_master §4)
**/data/**
!**/data/**/
!**/data/**/.gitkeep
**/*.log

# Node / webapp (later phases, created by plan0 B.1)
**/node_modules/
**/webapp/dist/

# Local IDE / tooling state — machine-specific, never shared
.claude/settings.local.json
.github/

# OS noise
Thumbs.db
Desktop.ini

