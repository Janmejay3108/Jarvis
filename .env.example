# ============================================================================
# JARVIS (ENOVIA) — PoC ENVIRONMENT TEMPLATE
# Copy this file to `.env` and fill values as PoCs proceed. NEVER commit `.env`.
# ============================================================================

# --- Jira (Data Center → REST v2) -------------------------------------------
# Base URL for Jira Data Center where TESTAUTOMA tickets live.
JIRA_BASE_URL=
# Jira Personal Access Token (bearer token for REST API authentication).
JIRA_PAT=

# --- Bitbucket (Server / Data Center) ---------------------------------------
BITBUCKET_BASE_URL=
# Bitbucket PAT — used for cloning the repo and later for branch/PR operations.
BITBUCKET_PAT=
# The Enovia test automation repo URL (clone target, branch: Testing_Mar10).
BITBUCKET_REPO_URL=
BITBUCKET_BRANCH=

# --- PRODUCTION DAI (evidence by runid — READ-ONLY) -------------------------
# epcorpappsdai12, DAI 25.3.1+0. Auth scheme: OAuth2 client-credentials against
# the Keycloak realm. This is NOT the JARVIS DAI below — never share a client,
# a base URL or a token cache between the two.
# DAI base URL — shared root for auth, run-logs, and screenshot endpoints.
DAI_BASE_URL=
# DAI OAuth2 client credentials (grant_type: client_credentials).
DAI_CLIENT_ID=
DAI_CLIENT_SECRET=
# DAI token endpoint — POST with x-www-form-urlencoded body to get access_token.
DAI_AUTH_URL=
# DAI run logs endpoint — GET with bearer token; {runid} is replaced at runtime.
DAI_LOG_BY_RUNID_URL=
# DAI screenshot endpoint — GET with bearer token; {image_id} is replaced at runtime.
DAI_SCREENSHOT_URL=

# --- JARVIS validation gate (the validation cycle) --------------------------
# JARVIS DAI 26.2.2 on the co-located JARVIS VM. Auth scheme:
# POST /api/v2/auth -> bearer token, ~10-minute expiry, cached + refreshed.
# Distinct instance and distinct auth from the PRODUCTION DAI above.

# The VALIDATION repo — agentic-eggplant-automation. Force-pushed with the full
# candidate state on every validation cycle. Git remote name:
# `agentic-eggplant-automation`. NOT the production repo.
JARVIS_REPO_URL=
# PAT with force-push rights to refs/heads/Enovia on the validation repo.
JARVIS_PAT=
JARVIS_DAI_BASE_URL=
JARVIS_DAI_CLIENT_ID=
JARVIS_DAI_CLIENT_SECRET=
# Force-push target branch on the validation repo.
JARVIS_BRANCH=
# Git clone of the validation repo on the JARVIS VM (Design agent suites folder).
JARVIS_ENOVIA_SUITES_PATH_IN_VM=
# poll_backoff | webhook | eggplant_runner. poll_backoff is the day-one mode;
# webhook is the upgrade path once the profile is registered (open item O1).
JARVIS_COMPLETION_MODE=

# RETIRED — do not reintroduce:
#   PRACTICE_TEST_CONFIG_ID  -> superseded by tracks/enovia/test_config_registry.yaml
#                               (decision D3: one test config per suite, looked up at
#                               runtime; a single global scalar cannot express the map).
#   PRACTICE_STEP_SELECTION  -> resolved by decision D1 (the dispatcher pattern): the
#                               test config stays permanently static and only the
#                               dispatcher script's target line changes, via git.

# Selected validation mechanism. The local EPF runscript inner loop is deferred
# (see docs/later-enhancements.md); this replaces the old INNER_LOOP flag.
VALIDATION_MECHANISM=

# --- LLM (reasoning model) --------------------------------------------------
# The production configuration pins the reasoning model; these keys support
# local credentials and PoC scripts without placing values in tracked files.

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
MODEL=
MODEL_LIGHT=

# Azure OpenAI path on the same gateway — kept available as a fallback for
# scripts/probe_gpt54.py and any future plan-deviation work.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
LLM_MODEL=
